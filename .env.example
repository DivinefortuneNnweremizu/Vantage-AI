# Vantage AI environment variables. Copy to .env.local and fill in values.
# Never commit real values.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Prisma). DATABASE_URL is the pooled connection used at runtime.
# DIRECT_URL is the direct connection used for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Only needed for "prisma migrate dev". The local dev database prints its own value.
SHADOW_DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Analyses allowed per user every 10 minutes. Default 10.
ANALYSIS_RATE_LIMIT=10

# AI. Use "mock" until the DeepSeek integration is ready.
AI_PROVIDER=mock
DEEPSEEK_API_KEY=

# Figma OAuth
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:3000/integrations/figma/callback

# Encryption (32 random bytes, base64). Used for Figma tokens at rest.
TOKEN_ENCRYPTION_KEY=

# Flutterwave
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLW_ENCRYPTION_KEY=

# Email
RESEND_API_KEY=

# Analytics and monitoring
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# Vantage AI environment variables. Copy to .env.local and fill in values.
# Never commit real values.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Prisma). DATABASE_URL is the pooled connection used at runtime.
# DIRECT_URL is the direct connection used for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Only needed for "prisma migrate dev". The local dev database prints its own value.
SHADOW_DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Analyses allowed per user every 10 minutes. Default 10.
ANALYSIS_RATE_LIMIT=10

# AI. "mock" returns clearly labeled demo reports and needs no key.
# "gemini" or "deepseek" send designs to that provider for real analysis.
# With AI_PROVIDER unset, GEMINI_API_KEY selects Gemini, otherwise DEEPSEEK_API_KEY selects DeepSeek.
AI_PROVIDER=mock

# Gemini has a free tier that accepts images. Get a key from Google AI Studio.
GEMINI_API_KEY=
# Optional. "gemini-3.5-flash-lite" is lighter and faster.
GEMINI_MODEL=gemini-3.6-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Real analyses allowed per person, and across the whole site, in any 24 hours. Past a cap the person
# gets a labeled demo report. In production, demo reports also need ALLOW_DEMO_AI=

# Visitors from these countries get a demo report instead of real AI. The default is the EEA, Switzerland
# and the UK, where Google's free Gemini tier cannot be used for apps that serve people. Set "none" if you
# pay for the provider, or a list like "DE,FR". Needs Vercel's x-vercel-ip-country header, so it does
# nothing locally.
REAL_AI_BLOCKED_COUNTRIES=true.
REAL_AI_PER_USER_PER_DAY=3
REAL_AI_PER_DAY=50
ALLOW_DEMO_AI=

# Figma OAuth
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:3000/integrations/figma/callback

# Encryption (32 random bytes, base64). Used for Figma tokens at rest.
TOKEN_ENCRYPTION_KEY=

# Flutterwave
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLW_ENCRYPTION_KEY=

# Email
RESEND_API_KEY=

# Analytics and monitoring
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# Showcase mode: show the prototype without Supabase. Sign-in is a fake one where every browser gets its own
# temporary account (any email and password works), and uploaded images are kept in the database.
# This is NOT real security. Never use it for real people's data. It needs a Postgres DATABASE_URL, but no Supabase.
SHOWCASE_MODE=
# "local" (disk, development only), "supabase", or "database" (the default in showcase mode).
STORAGE_DRIVER=

{
  "name": "vantage-launch-video",
  "private": true,
  "version": "1.0.0",
  "description": "Launch film for Vantage AI, in landscape and portrait. Built from code with Remotion; the soundtrack is synthesized in Python.",
  "scripts": {
    "studio": "remotion studio src/index.ts --port=3777",
    "audio": "python scripts/soundtrack.py",
    "render:landscape": "remotion render src/index.ts Landscape out/silent-landscape.mp4 --codec=h264 --port=3777",
    "render:portrait": "remotion render src/index.ts Portrait out/silent-portrait.mp4 --codec=h264 --port=3777",
    "render": "npm run audio && npm run render:landscape && npm run render:portrait && node scripts/mux.mjs"
  },
  "dependencies": {
    "@fontsource/open-sauce-two": "^5.3.0",
    "@remotion/cli": "^4.0.537",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
